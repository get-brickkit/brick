{
  "name": "@brickkit/crud",
  "version": "0.15.0",
  "description": "Opt-in resource CRUD plugin for Brick",
  "homepage": "https://brickkit.dev",
  "keywords": [
    "typescript",
    "bun",
    "crud",
    "drizzle-orm",
    "postgres",
    "sqlite",
    "rest-api",
    "typebox",
    "backend-framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-brickkit/brick.git",
    "directory": "packages/crud"
  },
  "type": "module",
