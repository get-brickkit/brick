  "devDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "@types/bun": "^1.4.4",
    "drizzle-orm": "^0.45.4"
  },
  "publishConfig": {
