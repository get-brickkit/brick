{
  "name": "@brickkit/cli",
  "version": "0.12.0",
  "description": "CLI and server engine for Brick-TS",
  "homepage": "https://brickkit.dev",
  "keywords": [
    "typescript",
    "bun",
    "cli",
    "dev-server",
    "elysia",
    "openapi-generator",
    "typed-client",
    "vite-plugin",
    "build-tool",
    "mcp"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "brick": "dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./compiler": {
      "import": "./dist/compiler.js",
      "types": "./dist/compiler.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    },
    "./production-dashboard": {
      "import": "./dist/production-dashboard.js",
      "types": "./dist/production-dashboard.d.ts"
    },
    "./dashboard": {
      "import": "./dashboard-dist/kit.js",
      "types": "./dist/dashboard.d.ts"
    },
    "./dev-reporter": {
      "import": "./dist/dev-reporter.js",
      "types": "./dist/dev-reporter.d.ts"
    },
    "./lint/eslint": {
      "import": "./dist/lint/eslint.js",
      "types": "./dist/lint/eslint.d.ts"
    },
    "./lint/oxlint": {
      "import": "./dist/lint/oxlint.js",
      "types": "./dist/lint/oxlint.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    },
    "./vite/client": {
      "types": "./vite-client.d.ts"
    },
    "./workflows": {
      "import": "./dist/workflows.js",
      "types": "./dist/workflows.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "dashboard-dist",
    "inspector-dist",
    "vite-client.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-brickkit/brick.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "bun scripts/build-inspector.ts && bun scripts/build-dashboard.ts && tsdown && tsdown -c tsdown.dashboard.config.ts",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p dashboard/tsconfig.json",
    "test": "bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@brickkit/core": "^0.12.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@sinclair/typebox": "^0.34.52",
    "class-variance-authority": "^0.7.1",
    "commander": "^15.0.0",
    "drizzle-kit": "^0.31.11",
    "elysia": "2.0.0-rc.1"
  },
  "devDependencies": {
    "@brickkit/workflow-inspector": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@fumadocs/base-ui": "16.17.10",
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@workflow/builders": "5.0.7",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.17.10",
    "fumadocs-openapi": "12.5.8",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.10",
    "geist": "^1.9.0",
    "lucide-react": "^1.67.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tsdown": "^0.23.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "workflow": "5.3.0"
  },
  "peerDependencies": {
    "@mdx-js/mdx": "^3.0.0",
    "fumadocs-core": "^16.0.0",
    "vite": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "eslint": ">=9.0.0",
    "oxlint": ">=1.88.0"
  },
  "peerDependenciesMeta": {
    "@mdx-js/mdx": {
      "optional": true
    },
    "fumadocs-core": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  }
}
