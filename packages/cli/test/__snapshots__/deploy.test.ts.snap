exports[`brick build --deploy adds HTTPS for a domain: traefik/traefik.yml (domain) 1`] = `
"# Generated by brick build --deploy. Rerun it instead of editing.
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"

certificatesResolvers:
  brick:
    acme:
      storage: /letsencrypt/acme.json
      httpChallenge:
        entryPoint: web

providers:
  file:
    filename: /etc/traefik/dynamic.yml
"
`;

exports[`brick build --deploy adds HTTPS for a domain: traefik/dynamic.yml (domain) 1`] = `
"# Generated by brick build --deploy. Rerun it instead of editing.
http:
  middlewares:
    strip-brick-headers:
      headers:
        customRequestHeaders:
          X-Brick-Internal: ""
          X-Brick-User: ""
          X-Brick-Caller: ""
          X-Brick-Tenant: ""

  routers:
    billing:
      rule: "Host(\`app.example.com\`) && PathPrefix(\`/api/billing/\`)"
      service: billing
      entryPoints: [websecure]
      middlewares: [strip-brick-headers]
      priority: 3
      tls:
        certResolver: brick

    fx-rates:
      rule: "Host(\`app.example.com\`) && PathPrefix(\`/api/fx-rates/\`)"
      service: fx-rates
      entryPoints: [websecure]
      middlewares: [strip-brick-headers]
      priority: 2
      tls:
        certResolver: brick

    app:
      rule: "Host(\`app.example.com\`) && PathPrefix(\`/\`)"
      service: app
      entryPoints: [websecure]
      middlewares: [strip-brick-headers]
      priority: 1
      tls:
        certResolver: brick

  services:
    app:
      loadBalancer:
        servers:
          - url: "http://app:3000"

    billing:
      loadBalancer:
        servers:
          - url: "http://billing:4001"

    fx-rates:
      loadBalancer:
        servers:
          - url: "http://fx-rates:4002"
"
`;

