            - containerPort: 4001
          env:
            - name: BRICK_SERVICES
              value: "{\\"orders\\":\\"http://app:3000/_brick/call/orders\\",\\"billing\\":\\"http://billing:4001\\",\\"fxRates\\":\\"http://fx-rates:4002\\"}"
            - name: BRICK_INTERNAL_TOKEN
              valueFrom:
                secretKeyRef: { name: brick, key: BRICK_INTERNAL_TOKEN }
            - name: BRICK_HOST
              value: "0.0.0.0"
            - name: BRICK_PORT
              value: "4001"
            - name: BRICK_PREFIX
              value: "/api"
            - name: BRICK_JWT_ISSUER
              value: "https://app.example.com"
            - name: BRICK_JWKS_URL
              value: "http://app:3000/api/auth/jwks"
            - name: BRICK_CORS
              value: "{\\"origin\\":[\\"https://app.example.com\\"],\\"credentials\\":true}"
---
apiVersion: v1
kind: Service
metadata:
  name: billing
spec:
  selector: { app: billing }
  ports:
    - port: 4001
      targetPort: 4001
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fx-rates
spec:
  replicas: 1
  selector:
    matchLabels: { app: fx-rates }
  template:
    metadata:
      labels: { app: fx-rates }
    spec:
      containers:
        - name: fx-rates
          image: fx-rates:latest
          imagePullPolicy: IfNotPresent
          ports:
