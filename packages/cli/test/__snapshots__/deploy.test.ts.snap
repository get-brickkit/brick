        "BRICK_JWKS_URL": "http://app:3000/api/auth/jwks",
        "BRICK_CORS": "{\\"origin\\":[\\"https://app.example.com\\"],\\"credentials\\":true}"
      }
    }
  ],
  "routes": [
    {
      "path": "/api/billing/",
      "upstream": "billing"
    },
    {
      "path": "/api/fx-rates/",
      "upstream": "fx-rates"
    },
    {
      "path": "/",
      "upstream": "app"
    }
  ],
  "app": {
    "build": "bun x brick build",
    "start": "bun dist/brick/server.js"
  }
}
"
`;

exports[`brick build --deploy writes every target: caddy/Caddyfile 1`] = `
"# Generated by brick build --deploy. Rerun it instead of editing.
:80 {
	request_header -X-Brick-Internal
	request_header -X-Brick-User
	request_header -X-Brick-Caller
	request_header -X-Brick-Tenant

	handle /api/billing/* {
		reverse_proxy billing:4001 {
			transport http {
				keepalive_idle_conns_per_host 256
			}
		}
	}

	handle /api/fx-rates/* {
		reverse_proxy fx-rates:4002 {
			transport http {
				keepalive_idle_conns_per_host 256
			}
		}
	}

	handle {
		reverse_proxy app:3000 {
			transport http {
				keepalive_idle_conns_per_host 256
			}
		}
	}
}
"
`;

exports[`brick build --deploy writes every target: nginx/nginx.conf 1`] = `
"# Generated by brick build --deploy. Rerun it instead of editing.
events {}

http {
    # WebSocket upgrades pass through; plain requests keep the upstream keep-alive.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        "" "";
    }

    upstream app {
        server app:3000;
        keepalive 256;
    }

    upstream billing {
        server billing:4001;
        keepalive 256;
    }

    upstream fx_rates {
        server fx-rates:4002;
        keepalive 256;
    }

    server {
        listen 80;
        server_name _;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Brick-Internal "";
        proxy_set_header X-Brick-User "";
        proxy_set_header X-Brick-Caller "";
        proxy_set_header X-Brick-Tenant "";

        location /api/billing/ {
            proxy_pass http://billing;
        }

        location /api/fx-rates/ {
            proxy_pass http://fx_rates;
        }

        location / {
            proxy_pass http://app;
        }
    }
}
"
`;

