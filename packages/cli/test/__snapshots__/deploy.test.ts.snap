exports[`brick build --deploy writes every target: traefik/dynamic.yml 1`] = `
"# Generated by brick build --deploy. Rerun it instead of editing.
http:
  middlewares:
    strip-brick-headers:
      headers:
        customRequestHeaders:
          X-Brick-Internal: ""
          X-Brick-User: ""
          X-Brick-Caller: ""
          X-Brick-Tenant: ""

  routers:
    billing:
      rule: "PathPrefix(\`/api/billing/\`)"
      service: billing
      entryPoints: [web]
      middlewares: [strip-brick-headers]
      priority: 3

    fx-rates:
      rule: "PathPrefix(\`/api/fx-rates/\`)"
      service: fx-rates
      entryPoints: [web]
      middlewares: [strip-brick-headers]
      priority: 2

    app:
      rule: "PathPrefix(\`/\`)"
      service: app
      entryPoints: [web]
      middlewares: [strip-brick-headers]
      priority: 1

  services:
    app:
      loadBalancer:
        servers:
          - url: "http://app:3000"

    billing:
      loadBalancer:
        servers:
          - url: "http://billing:4001"

    fx-rates:
      loadBalancer:
        servers:
          - url: "http://fx-rates:4002"
"
`;

exports[`brick build --deploy writes every target: kubernetes/brick.yaml 1`] = `
"# Generated by brick build --deploy. Rerun it instead of editing.
# Create the token first: kubectl create secret generic brick --from-literal=BRICK_INTERNAL_TOKEN=$(openssl rand -hex 24) --from-literal=BRICK_JWT_ISSUER=https://<your public host>
# An Ingress can't remove request headers, so x-brick-* reaches the services: each
# one ignores them without BRICK_INTERNAL_TOKEN, and answers a wrong token with 401.
# To also strip them at the edge, route with the Gateway API and a RequestHeaderModifier.
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app
spec:
  replicas: 1
  selector:
    matchLabels: { app: app }
  template:
    metadata:
      labels: { app: app }
    spec:
      containers:
        - name: app
          image: app:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 3000
          env:
            - name: NODE_ENV
              value: "production"
            - name: PORT
              value: "3000"
            - name: BRICK_SERVICES
              value: "{\\"orders\\":\\"http://app:3000/_brick/call/orders\\",\\"billing\\":\\"http://billing:4001\\",\\"fxRates\\":\\"http://fx-rates:4002\\"}"
            - name: BRICK_INTERNAL_TOKEN
              valueFrom:
                secretKeyRef: { name: brick, key: BRICK_INTERNAL_TOKEN }
---
apiVersion: v1
kind: Service
metadata:
  name: app
spec:
  selector: { app: app }
  ports:
    - port: 3000
      targetPort: 3000
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: billing
spec:
  replicas: 1
  selector:
    matchLabels: { app: billing }
  template:
    metadata:
      labels: { app: billing }
    spec:
      containers:
        - name: billing
          image: billing:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 4001
          env:
            - name: BRICK_SERVICES
              value: "{\\"orders\\":\\"http://app:3000/_brick/call/orders\\",\\"billing\\":\\"http://billing:4001\\",\\"fxRates\\":\\"http://fx-rates:4002\\"}"
            - name: BRICK_INTERNAL_TOKEN
              valueFrom:
                secretKeyRef: { name: brick, key: BRICK_INTERNAL_TOKEN }
            - name: BRICK_HOST
              value: "0.0.0.0"
            - name: BRICK_PORT
              value: "4001"
            - name: BRICK_PREFIX
              value: "/api"
            - name: BRICK_JWT_ISSUER
              valueFrom:
                secretKeyRef: { name: brick, key: BRICK_JWT_ISSUER }
            - name: BRICK_JWKS_URL
              value: "http://app:3000/api/auth/jwks"
            - name: BRICK_CORS
              value: "{\\"origin\\":[\\"https://app.example.com\\"],\\"credentials\\":true}"
---
apiVersion: v1
kind: Service
metadata:
  name: billing
spec:
  selector: { app: billing }
  ports:
    - port: 4001
      targetPort: 4001
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fx-rates
spec:
  replicas: 1
  selector:
    matchLabels: { app: fx-rates }
  template:
    metadata:
      labels: { app: fx-rates }
    spec:
      containers:
        - name: fx-rates
          image: fx-rates:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 4002
          env:
            - name: BRICK_SERVICES
              value: "{\\"orders\\":\\"http://app:3000/_brick/call/orders\\",\\"billing\\":\\"http://billing:4001\\",\\"fxRates\\":\\"http://fx-rates:4002\\"}"
            - name: BRICK_INTERNAL_TOKEN
              valueFrom:
                secretKeyRef: { name: brick, key: BRICK_INTERNAL_TOKEN }
            - name: BRICK_HOST
              value: "0.0.0.0"
            - name: BRICK_PORT
              value: "4002"
            - name: BRICK_PREFIX
              value: "/api"
            - name: BRICK_JWT_ISSUER
              valueFrom:
                secretKeyRef: { name: brick, key: BRICK_JWT_ISSUER }
            - name: BRICK_JWKS_URL
              value: "http://app:3000/api/auth/jwks"
            - name: BRICK_CORS
              value: "{\\"origin\\":[\\"https://app.example.com\\"],\\"credentials\\":true}"
---
apiVersion: v1
kind: Service
metadata:
  name: fx-rates
spec:
  selector: { app: fx-rates }
  ports:
    - port: 4002
      targetPort: 4002
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: brick
spec:
  rules:
    - http:
        paths:
          - path: /api/billing/
            pathType: Prefix
            backend:
              service:
                name: billing
                port: { number: 4001 }
          - path: /api/fx-rates/
            pathType: Prefix
            backend:
              service:
                name: fx-rates
                port: { number: 4002 }
          - path: /
            pathType: Prefix
            backend:
              service:
                name: app
                port: { number: 3000 }
"
`;

exports[`brick build --deploy writes every target: compose/compose.yaml 1`] = `
"# Generated by brick build --deploy. Rerun it instead of editing.
# Set BRICK_INTERNAL_TOKEN (and BRICK_JWT_ISSUER, your public URL) in deploy/compose/.env.
services:
  app:
    build:
      context: ../..
      dockerfile: deploy/compose/app.Dockerfile
    restart: unless-stopped
    environment:
      NODE_ENV: "production"
      PORT: "3000"
      BRICK_SERVICES: "{\\"orders\\":\\"http://app:3000/_brick/call/orders\\",\\"billing\\":\\"http://billing:4001\\",\\"fxRates\\":\\"http://fx-rates:4002\\"}"
      BRICK_INTERNAL_TOKEN: "\${BRICK_INTERNAL_TOKEN:?set BRICK_INTERNAL_TOKEN, a long random secret}"

  billing:
    build:
      context: ../..
      dockerfile: deploy/compose/billing.Dockerfile
    restart: unless-stopped
    environment:
      BRICK_SERVICES: "{\\"orders\\":\\"http://app:3000/_brick/call/orders\\",\\"billing\\":\\"http://billing:4001\\",\\"fxRates\\":\\"http://fx-rates:4002\\"}"
      BRICK_INTERNAL_TOKEN: "\${BRICK_INTERNAL_TOKEN:?set BRICK_INTERNAL_TOKEN, a long random secret}"
      BRICK_HOST: "0.0.0.0"
      BRICK_PORT: "4001"
      BRICK_PREFIX: "/api"
      BRICK_JWT_ISSUER: "\${BRICK_JWT_ISSUER:-http://localhost}"
      BRICK_JWKS_URL: "http://app:3000/api/auth/jwks"
      BRICK_CORS: "{\\"origin\\":[\\"https://app.example.com\\"],\\"credentials\\":true}"

  fx-rates:
    build:
      context: ../../..
      dockerfile: deploy/deploy/compose/fx-rates.Dockerfile
    restart: unless-stopped
    environment:
      BRICK_SERVICES: "{\\"orders\\":\\"http://app:3000/_brick/call/orders\\",\\"billing\\":\\"http://billing:4001\\",\\"fxRates\\":\\"http://fx-rates:4002\\"}"
      BRICK_INTERNAL_TOKEN: "\${BRICK_INTERNAL_TOKEN:?set BRICK_INTERNAL_TOKEN, a long random secret}"
      BRICK_HOST: "0.0.0.0"
      BRICK_PORT: "4002"
      BRICK_PREFIX: "/api"
      BRICK_JWT_ISSUER: "\${BRICK_JWT_ISSUER:-http://localhost}"
      BRICK_JWKS_URL: "http://app:3000/api/auth/jwks"
      BRICK_CORS: "{\\"origin\\":[\\"https://app.example.com\\"],\\"credentials\\":true}"

  proxy:
    image: caddy:2
    restart: unless-stopped
    ports: ["80:80"]
    volumes:
      - ../caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
    depends_on: [app, billing, fx-rates]

volumes:
  caddy-data:
"
`;

exports[`brick build --deploy writes every target: compose/app.Dockerfile 1`] = `
"# Generated by brick build --deploy. Rerun it instead of editing.
FROM oven/bun:1
WORKDIR /app
COPY . .
ENV BRICK_SKIP_REMOTE_BUILD=1
RUN bun install --frozen-lockfile && bun x brick build
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
CMD ["/bin/sh", "-c", "bun dist/brick/server.js"]
"
`;

exports[`brick build --deploy writes every target: compose/app.Dockerfile.dockerignore 1`] = `
"**/node_modules
**/.git
**/.env
**/.env.*
dist
deploy
"
`;

exports[`brick build --deploy writes every target: compose/billing.Dockerfile 1`] = `
"# Generated by brick build --deploy. Rerun it instead of editing.
FROM golang:1.26-trixie AS build
WORKDIR /src
COPY shared shared
COPY services/billing services/billing
WORKDIR /src/services/billing
RUN go build -o bin/billing .

FROM debian:trixie-slim
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /src/services/billing/bin/billing /usr/local/bin/service
ENV BRICK_HOST=0.0.0.0 BRICK_PORT=4001
EXPOSE 4001
CMD ["/usr/local/bin/service"]
"
`;

