            - name: BRICK_SERVICES
              value: "{\\"orders\\":\\"http://app:3000/_brick/call/orders\\",\\"billing\\":\\"http://billing:4001\\",\\"fxRates\\":\\"http://fx-rates:4002\\"}"
            - name: BRICK_INTERNAL_TOKEN
              valueFrom:
                secretKeyRef: { name: brick, key: BRICK_INTERNAL_TOKEN }
            - name: BRICK_HOST
              value: "0.0.0.0"
            - name: BRICK_PORT
              value: "4002"
            - name: BRICK_PREFIX
              value: "/api"
            - name: BRICK_JWT_ISSUER
              value: "https://app.example.com"
            - name: BRICK_JWKS_URL
              value: "http://app:3000/api/auth/jwks"
            - name: BRICK_CORS
              value: "{\\"origin\\":[\\"https://app.example.com\\"],\\"credentials\\":true}"
---
apiVersion: v1
kind: Service
metadata:
  name: fx-rates
spec:
  selector: { app: fx-rates }
  ports:
    - port: 4002
      targetPort: 4002
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: brick
spec:
  tls:
    - hosts: [app.example.com]
      secretName: brick-tls
  rules:
    - host: app.example.com
      http:
        paths:
          - path: /api/billing/
            pathType: Prefix
            backend:
              service:
                name: billing
                port: { number: 4001 }
          - path: /api/fx-rates/
            pathType: Prefix
            backend:
              service:
                name: fx-rates
                port: { number: 4002 }
          - path: /
            pathType: Prefix
            backend:
              service:
                name: app
                port: { number: 3000 }
"
`;

exports[`brick build --deploy routes a TS-only app entirely to Bun: ts-only Caddyfile 1`] = `
"# Generated by brick build --deploy. Rerun it instead of editing.
:80 {
	request_header -X-Brick-Internal
	request_header -X-Brick-User
	request_header -X-Brick-Caller
	request_header -X-Brick-Tenant

	handle {
		reverse_proxy app:3000 {
			transport http {
				keepalive_idle_conns_per_host 256
			}
		}
	}
}
"
`;

exports[`brick build --deploy routes a TS-only app entirely to Bun: ts-only compose 1`] = `
"# Generated by brick build --deploy. Rerun it instead of editing.
services:
  app:
    build:
      context: ../..
      dockerfile: deploy/compose/app.Dockerfile
    restart: unless-stopped
    environment:
      NODE_ENV: "production"
      PORT: "3000"

  proxy:
    image: caddy:2
    restart: unless-stopped
    ports: ["80:80"]
    volumes:
      - ../caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
    depends_on: [app]

volumes:
  caddy-data:
"
`;
