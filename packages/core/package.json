{
  "name": "@brickkit/core",
  "version": "0.13.2",
  "description": "Core engine primitives for the Brick-TS framework",
  "homepage": "https://brickkit.dev",
  "keywords": [
    "typescript",
    "bun",
    "backend-framework",
    "elysia",
    "drizzle-orm",
    "typebox",
    "rest-api",
    "openapi",
    "crud",
    "typed-client",
    "mcp"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./pg": {
      "import": "./dist/pg.js",
      "types": "./dist/pg.d.ts"
    },
    "./workflow": {
      "import": "./dist/workflow.js",
      "types": "./dist/workflow.d.ts"
    },
    "./tanstack-query": {
      "import": "./dist/tanstack-query.js",
      "types": "./dist/tanstack-query.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-brickkit/brick.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.types.json",
    "test": "bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@sinclair/typebox": "^0.34.52",
    "elysia": "2.0.0-rc.1",
    "postgres": "^4.0.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@tanstack/query-core": "5.105.3",
    "@tanstack/vue-query": "5.105.3",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "^0.45.4",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.0.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.2"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    }
  }
}
