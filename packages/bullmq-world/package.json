{
  "name": "@brickkit/bullmq-world",
  "version": "0.11.0",
  "description": "Redis and BullMQ world for the Workflow SDK: durable runs, steps, hooks and streams on Redis",
  "homepage": "https://brickkit.dev",
  "keywords": [
    "bullmq",
    "durable-functions",
    "redis",
    "workflow"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-brickkit/brick.git",
    "directory": "packages/bullmq-world"
  },
  "bin": {
    "brickkit-bullmq-world-setup": "./bin/setup.js"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:e2e": "bun run build && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@brickkit/redis-world": "^0.11.0",
    "@workflow/errors": "5.1.0",
    "@workflow/utils": "5.0.2",
    "@workflow/world": "5.1.0",
    "bullmq": "^6.5.4",
    "ioredis": "^6.0.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^26.6.6",
    "@workflow/cli": "5.0.7",
    "@workflow/core": "5.3.0",
    "@workflow/world-testing": "5.0.7",
    "hono": "^4.13.16",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "workflow": "5.3.0"
  }
}
