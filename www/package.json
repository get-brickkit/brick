{
  "name": "www",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "examples:generate": "bun scripts/generate-examples.ts",
    "api:generate": "bun scripts/generate-api-reference.ts",
    "dev": "bun run api:generate && bun run examples:generate && bun run og:generate && vite dev",
    "build": "bun run docs:check && bun run examples:generate && bun run og:generate && vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "types:check": "bun run api:generate && fumadocs-mdx && bun run examples:generate && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "docs:check": "bun run api:generate && bun scripts/check-docs-markdown.ts && bun test test",
    "docs:http-check": "bun scripts/check-docs-http.ts",
    "og:generate": "bun scripts/generate-og.tsx"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.108",
    "@ai-sdk/react": "^4.0.166",
    "@base-ui/react": "^1.9.0",
    "@fumadocs/base-ui": "16.17.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-presence": "^1.1.11",
    "@shikijs/magic-move": "^4.6.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "ai": "^7.0.162",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "flexsearch": "^0.8.212",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.10",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "lucide-react": "^1.67.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.9.1",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.5",
    "zod": "^4.6.7",
    "mdast-util-mdx": "^3.0.0"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.4",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "gray-matter": "^4.0.3",
    "nitro": "3.0.261103-rc",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "remark-mdx": "^3.1.1",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.4",
